{
    "name": "allymailer/allymailer-laravel",
    "version": "2.1.1",
    "description": "AllyMailer Web API for Laravel: API client, mail transport, webhooks",
    "type": "library",
    "license": "MIT",
    "keywords": [
        "allymailer",
        "laravel",
        "email",
        "mail",
        "webhook"
    ],
    "homepage": "https://github.com/allymailer/allymailer-laravel",
    "require": {
        "php": ">=8.1",
        "allymailer/allymailer-sdk": "^2.1.1",
        "illuminate/http": "^10.0|^11.0|^12.0",
        "illuminate/mail": "^10.0|^11.0|^12.0",
        "illuminate/routing": "^10.0|^11.0|^12.0",
        "illuminate/support": "^10.0|^11.0|^12.0",
        "symfony/mailer": "^6.2|^7.0"
    },
    "autoload": {
        "psr-4": {
            "AllyMailer\\Wrapper\\": "src/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "AllyMailer\\Wrapper\\AllyMailerServiceProvider"
            ],
            "aliases": {
                "AllyMailer": "AllyMailer\\Wrapper\\Facades\\AllyMailer"
            }
        }
    },
    "config": {
        "sort-packages": true
    }
}
